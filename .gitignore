# Downloaded packages and extraction outputs are ignored by default.
/.download-manifest/**
/audio/**
/graphics/textures/**

# Exceptions retain the manifest and assets that downloads cannot reproduce.
!/.download-manifest/manifest.json

# Allow the parent directories before including their selected files.
!/graphics/textures/misc/
!/graphics/textures/misc/HyperMaze.png
!/graphics/textures/misc/invaders.png
!/graphics/textures/misc/invaders.xcf
!/graphics/textures/misc/player-large.png
!/graphics/textures/misc/player.png
!/graphics/textures/misc/rover.png

!/graphics/textures/tilesets/
!/graphics/textures/tilesets/tileset.png

!/graphics/textures/ui/
!/graphics/textures/ui/WhiteBackdrop.png
!/graphics/textures/ui/grid.png
!/graphics/textures/ui/quadrants-alt.png
!/graphics/textures/ui/quadrants.png
!/graphics/textures/ui/white_button.png

# Archives stay local even if they appear outside a download directory.
*.[zZ][iI][pP]
*.7[zZ]
*.[rR][aA][rR]
*.[tT][aA][rR]
*.[gG][zZ]
*.[bB][zZ]2
*.[xX][zZ]
*.[zZ][sS][tT]
*.[tT][gG][zZ]
*.[tT][bB][zZ]
*.[tT][bB][zZ]2
*.[tT][xX][zZ]
*.[tT][zZ][sS][tT]

# Local tools, editor state, logs, and interrupted downloads.
.idea/
.obsidian/
.trash/
/.cache/
__pycache__/
*.py[cod]
*.log
*.part
*.partial
*.download
*.crdownload
.DS_Store
Thumbs.db

# Git ignore rules cannot filter by size. Keep other committed binaries at or
# below 5 MiB; larger files and bulk collections belong in external downloads.
