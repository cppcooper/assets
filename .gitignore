# Downloaded packages are populated from the source manifest.
/.download-manifest/**
!/.download-manifest/manifest.json

# Collections recreated by init.sh, including their license and source notes.
/audio/music/Minifantasy_ForgottenPlains_Music/
/audio/sfx/DungonCrawlGameSounds/
/audio/sfx/Minifantasy_Forgotten_Plains_SFX/
/audio/sfx/Helton Yan's Pixel Combat - Single Files/
/graphics/textures/MiniWorldSprites/
/graphics/textures/Minifantasy_ForgottenPlains/
/graphics/textures/char-customizer/

# Individual textures recreated by init.sh.
/graphics/textures/tilesets/dungeon_tiles.png
/graphics/textures/tilesets/magecity.png
/graphics/textures/tilesets/punyworld-overworld-tileset.png

# Assets without download mappings remain eligible for Git, including misc/, UI,
# and tilesets/tileset.png. The download manifest still excludes misc/ entirely.

# Archives stay local even if they appear outside a download directory.
*.[zZ][iI][pP]
*.7[zZ]
*.[rR][aA][rR]
*.[tT][aA][rR]
*.[gG][zZ]
*.[bB][zZ]2
*.[xX][zZ]
*.[zZ][sS][tT]
*.[tT][gG][zZ]
*.[tT][bB][zZ]
*.[tT][bB][zZ]2
*.[tT][xX][zZ]
*.[tT][zZ][sS][tT]

# Local tools, editor state, logs, and interrupted downloads.
.idea/
.obsidian/
.trash/
/.cache/
__pycache__/
*.py[cod]
*.log
*.part
*.partial
*.download
*.crdownload
.DS_Store
Thumbs.db

# Git ignore rules cannot filter by size. Keep other committed binaries at or
# below 5 MiB; larger files and bulk collections belong in external downloads.
