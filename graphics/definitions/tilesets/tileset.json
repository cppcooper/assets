{
  "$schema": "../../../schemas/graphics/sprite-tileset-manifest-2.0.schema.json",
  "asset_class": "sprite-tileset",
  "version": "2.0",
  "namespace": "tileset",
  "texture": "textures/tilesets/tileset.png",
  "defaults": {
    "sprite": {
      "pivot": {
        "x": 0.5,
        "y": 0.5
      }
    },
    "tileset": {
      "pivot": {
        "x": 0.0,
        "y": 1.0
      }
    }
  },
  "tilesets": {
    "tileset": {
      "description": "The four tiles from tileset.dat in original order. The source records no anchor; bottom-left placement follows the v2 tileset convention.",
      "grid": {
        "origin": {
          "x": 0,
          "y": 0
        },
        "frame": {
          "width": 100,
          "height": 100
        },
        "spacing": {
          "x": 0,
          "y": 0
        },
        "rows": 1,
        "columns": 4,
        "cell_order": "row-major"
      }
    }
  }
}
