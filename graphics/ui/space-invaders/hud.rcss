/* The font declaration below loads college-hud when this stylesheet loads.
   Source font size: SpaceInvaders.cpp:28; authored y: Height() - 50, :116.
   Use a top-origin 50px row. The original external Font::Print() glyph/baseline
   metrics are unavailable; tune this row's top offset after an in-engine preview.
   Original glyph atlas fontwhite.png is white; DejaVu Sans approximates its metrics.
   The legacy window was fixed at 900 x 700; the original anchors are retained when
   the viewport changes, including the score's left anchor at half the width. */
/* This bundled parser resolves font src against the process working directory.
   Launch from the repository root, which contains assets/. */
@font-face {
    font-family: college-hud;
    src: "assets/fonts/DejaVuSans.ttf";
    font-style: normal;
    font-weight: normal;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: college-hud;
    font-size: 28px;
    line-height: 28px;
    color: #ffffff;
    pointer-events: none;
}

.hud-field {
    position: absolute;
    top: 50px;
    white-space: pre;
    pointer-events: none;
}

#high-score-field {
    left: 50px;
}

#score-field {
    left: 50%;
}

#lives-field {
    right: 0px;
}
