<rml>
<head>
    <title>Game menu</title>
    <link type="text/rcss" href="game-menu.rcss" />
</head>
<body>
    <div class="menu-panel">
        <div id="pause-page" class="menu-page">
            <h1>Paused</h1>
            <input id="resume" class="menu-button" type="button" value="Resume" data-action="resume" />
            <input id="new-game" class="menu-button" type="button" value="New Game" data-action="new-game" />
            <input id="settings" class="menu-button" type="button" value="Settings" disabled="disabled" />
            <input id="high-scores" class="menu-button" type="button" value="High Scores" data-action="high-scores" />
            <input id="quit" class="menu-button" type="button" value="Quit" data-action="quit" />
        </div>
        <div id="scores-page" class="menu-page">
            <h1>High Scores</h1>
            <div id="score-list"></div>
            <input id="back" class="menu-button" type="button" value="Back" data-action="back" />
        </div>
        <div id="entry-page" class="menu-page">
            <h1>New High Score</h1>
            <div id="entry-score"></div>
            <p id="entry-help"></p>
            <form id="score-form">
                <label for="player-name">Your name</label>
                <input id="player-name" type="text" name="player-name" maxlength="24" />
                <input id="save-score" class="menu-button" type="submit" value="Save score" />
            </form>
            <input id="skip-score" class="menu-button secondary" type="button" value="Skip" data-action="skip-score" />
        </div>
        <div id="menu-error"></div>
    </div>
</body>
</rml>
